# Ejemplo de variables de entorno para el backend RAG.
# Copia este archivo como .env dentro de tu proyecto Docker real y
# complétalo con tus valores. Los nombres son solo referencia: ajústalos
# a los que ya usa tu implementación.

# Puerto en el que corre tu API
PORT=8000

# Modelo / proveedor LLM
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Base de datos vectorial (ej. pgvector)
# DATABASE_URL=

# Orígenes permitidos para CORS (dominio de Vercel del frontend)
# ALLOWED_ORIGINS=https://tu-portfolio.vercel.app,http://localhost:5173
